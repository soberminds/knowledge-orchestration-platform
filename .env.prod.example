# 容器端口与部署网络
FRONTEND_HTTP_PORT=80 # 前端 HTTP 端口；本地 Vite 默认 5173，生产 Nginx 通常用 80
BACKEND_HTTP_PORT=8000 # 后端 HTTP 端口；生产 compose 默认只绑定到服务器本机 127.0.0.1
VITE_API_BASE_URL= # 前端构建时使用的 API 地址；生产同源反向代理时留空
MIDDLEWARE_DOCKER_NETWORK=shared-middleware_default # 生产业务容器需要加入的既有中间件 Docker 网络名；本地不用 Docker 部署业务时可忽略

# 向量库基础配置
CHROMA_COLLECTION=rga_knowledge_base # Chroma 向量库集合名，同一套数据保持固定即可

# DeepSeek 配置
DEEPSEEK_API_KEY= # DeepSeek API Key，用于调用 DeepSeek 模型
DEEPSEEK_BASE_URL=https://api.deepseek.com # DeepSeek OpenAI 兼容接口地址
DEEPSEEK_MODEL=deepseek-v4-flash # 默认 DeepSeek 模型名称

# 其他大模型供应商配置
QWEN_API_KEY= # 通义千问 / 百炼 API Key，未使用可留空
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 # 通义千问 / 百炼 OpenAI 兼容接口地址
QWEN_RESPONSES_API_ENABLED=false # 是否启用千问 Responses API adapter；true 时千问原生联网优先走 Responses API，失败会回退 Chat Completions
ZAI_API_KEY= # ZAI 平台 API Key，未使用可留空
ZAI_BASE_URL=https://api.z.ai/api/paas/v4 # ZAI 平台接口地址
KIMI_API_KEY= # Kimi / Moonshot API Key，未使用可留空
KIMI_BASE_URL=https://api.moonshot.cn/v1 # Kimi / Moonshot 接口地址
HUNYUAN_API_KEY= # 腾讯混元 API Key，未使用可留空
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1 # 腾讯混元接口地址
SILICONFLOW_API_KEY= # 硅基流动 API Key，未使用可留空
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1 # 硅基流动接口地址
QIANFAN_API_KEY= # 百度千帆 API Key，未使用可留空
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2 # 百度千帆接口地址
OPENAI_API_KEY= # OpenAI API Key，未使用可留空
OPENAI_BASE_URL=https://api.openai.com/v1 # OpenAI 接口地址

# 模型路由和能力
AVAILABLE_MODELS=deepseek-v4-flash,deepseek-v4-pro,glm-4.5-air,hunyuan-lite,gpt-4o-mini,kimi-k2.6,qwen-max,qwen3.7-plus # 前端模型下拉框展示的模型列表，多个模型用英文逗号分隔
MODEL_PROVIDER_OVERRIDES_JSON={"hunyuan-lite":"hunyuan","gpt-4o-mini":"openai"} # 手工指定模型与供应商映射，避免只靠模型名前缀判断
MODEL_CAPABILITIES_JSON= # 自定义模型能力覆盖 JSON，例如多模态、工具调用、原生联网、深度思考等能力开关
EXTRA_PROVIDER_CONFIGS_JSON= # 额外 OpenAI 兼容网关配置 JSON，接自建代理或本地模型网关时使用
DEEPSEEK_DEEP_REASONING_EFFORT=high # DeepSeek 深度推理强度，可选 low、medium、high
QWEN_DEEP_THINKING_BUDGET=2048 # 通义模型深度思考预算，数值越大通常越耗 token

# 本地嵌入模型
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5 # 本地向量检索使用的 embedding 模型名称
EMBEDDING_DEVICE=cpu # embedding 模型运行设备，可选 cpu 或 cuda
HF_ENDPOINT=https://huggingface.co # Hugging Face 主下载地址
HF_FALLBACK_ENDPOINT=https://hf-mirror.com # Hugging Face 备用镜像地址，主地址失败时兜底
HF_HUB_DISABLE_TELEMETRY=1 # 是否关闭 Hugging Face 遥测，1 表示关闭

# 联网搜索
WEB_SEARCH_PROVIDER=none # 后端外部联网搜索供应商，可选 none、serper、tavily
WEB_SEARCH_API_KEY= # 联网搜索服务 API Key，未启用可留空
WEB_SEARCH_TOP_K=5 # 每次联网搜索返回的候选结果数量

# Agent 邮件发送工具
EMAIL_TOOL_ENABLED=false # 是否启用 Agent 邮件发送工具；即使启用，真实发送前仍需要用户确认
SMTP_HOST=smtp.qq.com # SMTP 服务器地址，例如 QQ 邮箱 smtp.qq.com，企业邮箱按服务商文档填写
SMTP_PORT=465 # SMTP 端口，SSL 通常是 465，STARTTLS 通常是 587
SMTP_USERNAME= # SMTP 登录用户名，通常是发件邮箱地址
SMTP_PASSWORD= # SMTP 密码或授权码；QQ 邮箱一般填写 SMTP 授权码，不是 QQ 登录密码
SMTP_USE_SSL=true # 是否使用 SMTP SSL 直连；端口 465 通常为 true
SMTP_STARTTLS=false # 是否启用 STARTTLS；如果 SMTP_USE_SSL=true 通常保持 false
SMTP_FROM_EMAIL= # 发件邮箱地址；留空时默认使用 SMTP_USERNAME
SMTP_FROM_NAME=知识编排平台 # 邮件发件人显示名称
SMTP_TIMEOUT_SEC=20 # SMTP 连接和发送超时时间，单位秒
EMAIL_TOOL_MAX_RECIPIENTS=5 # 单次邮件最多允许的收件人和抄送人数总和
EMAIL_TOOL_ALLOWED_DOMAINS= # 可选收件邮箱域名白名单，多个域名用英文逗号分隔；留空表示不限制

# 成本估算
COST_CURRENCY=USD # 前端费用估算展示的货币单位
MODEL_PRICING_JSON={"deepseek-v4-flash":{"input_per_1m_tokens":0.14,"output_per_1m_tokens":0.28},"deepseek-v4-pro":{"input_per_1m_tokens":0.435,"output_per_1m_tokens":0.87}} # 模型价格配置 JSON，按每百万 token 估算输入与输出成本

# RAG 参数
TOP_K=4 # 每次 RAG 检索返回给大模型的文档片段数量
CHUNK_SIZE=800 # 文档切片大小，越大上下文越完整但召回更粗
CHUNK_OVERLAP=120 # 相邻切片重叠字符数，用于减少切片断裂的信息损失
TEMPERATURE=0.2 # 生成温度，越低越稳定，越高越发散
MAX_TOKENS=1024 # 单次回答允许生成的最大 token 数
MAX_UPLOAD_MB=50 # 单个上传文件允许的最大体积，单位 MB；生产可按服务器带宽和磁盘调大
REBUILD_INDEX_ON_STARTUP=false # 后端启动时是否自动重建索引；本地开发可 true，生产建议 false

# 前端访问
CORS_ORIGINS=http://YOUR_SERVER_IP # 允许跨域访问后端的前端地址，多个地址用英文逗号分隔

# 文件预览
PREVIEW_CONVERT_TIMEOUT_SEC=120 # 文档转 PDF 预览的超时时间，单位秒
SOFFICE_BIN=/usr/bin/soffice # LibreOffice soffice 路径，用于 Office 转 PDF 和旧版 Office 抽取兜底

# ONLYOFFICE 在线编辑
ONLYOFFICE_DOCUMENT_SERVER_URL=http://YOUR_SERVER_IP:8088 # 浏览器访问 ONLYOFFICE Document Server 的地址；生产必须换成公网 IP 或域名
ONLYOFFICE_DOCUMENT_SERVER_INTERNAL_URL=http://middleware-onlyoffice # 后端探活和命令调用 ONLYOFFICE 时使用的地址；生产用中间件容器名
PUBLIC_BACKEND_URL=http://kop-backend:8000 # ONLYOFFICE 容器下载文件和回调后端时使用的后端地址；生产同网络下用后端容器名
PUBLIC_BACKEND_INTERNAL_URL=http://127.0.0.1:8000 # 后端进程本机访问自己的地址，用于内部探活或拼接
ONLYOFFICE_JWT_ENABLED=true # 是否启用 ONLYOFFICE JWT 安全校验
ONLYOFFICE_JWT_SECRET=local-onlyoffice-secret # ONLYOFFICE 与后端共享的 JWT 密钥，两边必须一致
ONLYOFFICE_VERIFY_CALLBACK_TOKEN=false # 是否严格校验 ONLYOFFICE 回调携带的 token
ONLYOFFICE_AUTO_REBUILD_INDEX_ON_SAVE=true # ONLYOFFICE 保存文档后是否自动更新知识库索引
ONLYOFFICE_INDEX_UPDATE_MODE=incremental # 保存后索引更新模式，可选 incremental 或 full
ONLYOFFICE_CALLBACK_TTL_SEC=86400 # ONLYOFFICE 回调 token 有效期，单位秒

# 聊天记忆数据库
MYSQL_URL= # 可选：完整 MySQL SQLAlchemy 连接串；填写后优先于 MYSQL_HOST 等拆分配置
MYSQL_HOST=middleware-mysql # MySQL 主机地址；本地常用 127.0.0.1，生产用中间件容器名
MYSQL_PORT=3306 # MySQL 端口
MYSQL_DATABASE=KOP # 聊天会话、消息、用户和文档元数据使用的数据库名
MYSQL_USER=root # MySQL 用户名；生产建议后续改成专用账号
MYSQL_PASSWORD=root123 # MySQL 密码；生产必须填写服务器真实密码
MYSQL_CHARSET=utf8mb4 # MySQL 连接字符集，建议 utf8mb4 以支持中文和 emoji
MYSQL_CONNECT_TIMEOUT_SEC=10 # MySQL 建连超时时间，单位秒
MYSQL_READ_TIMEOUT_SEC=30 # MySQL 读取超时时间，单位秒
MYSQL_WRITE_TIMEOUT_SEC=30 # MySQL 写入超时时间，单位秒

# 聊天记忆缓存
REDIS_URL= # 可选：完整 Redis 连接串；填写后优先于 REDIS_HOST 等拆分配置
REDIS_HOST=middleware-redis # Redis 主机地址；本地常用 127.0.0.1，生产用中间件容器名
REDIS_PORT=6379 # Redis 端口
REDIS_PASSWORD= # Redis 密码，未设置密码时留空
REDIS_DB=0 # Redis 数据库编号，默认使用 0

# 聊天上下文与消息策略
CHAT_DEFAULT_USERNAME=local-user # 未登录游客模式使用的默认本地用户名
CHAT_RECENT_MESSAGE_LIMIT=12 # 后端从数据库回读的最近消息条数
CHAT_CACHE_TTL_SEC=86400 # Redis 最近消息缓存有效期，单位秒
CHAT_SUMMARY_TRIGGER_MESSAGE_COUNT=20 # 预留：超过多少条消息后触发会话摘要
CHAT_SUMMARY_TARGET_TOKENS=800 # 预留：会话摘要目标 token 数
