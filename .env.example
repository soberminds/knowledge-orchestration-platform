# 向量库基础配置
CHROMA_COLLECTION=rga_knowledge_base # Chroma 向量库集合名，本地一般保持默认即可

# DeepSeek 核心模型配置
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY # DeepSeek 的 API Key，请替换成你自己的真实密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com # DeepSeek 的 OpenAI 兼容接口地址
DEEPSEEK_MODEL=deepseek-v4-flash # 默认使用的 DeepSeek 模型名称

# 其他大模型供应商配置
QWEN_API_KEY= # 通义千问的 API Key，未使用可留空
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 # 通义千问的 OpenAI 兼容接口地址
ZAI_API_KEY= # ZAI 平台的 API Key，未使用可留空
ZAI_BASE_URL=https://api.z.ai/api/paas/v4 # ZAI 平台的接口地址
KIMI_API_KEY= # Kimi / Moonshot 的 API Key，未使用可留空
KIMI_BASE_URL=https://api.moonshot.cn/v1 # Kimi / Moonshot 的接口地址
HUNYUAN_API_KEY= # 腾讯混元的 API Key，未使用可留空
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1 # 腾讯混元的接口地址
SILICONFLOW_API_KEY= # 硅基流动的 API Key，未使用可留空
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1 # 硅基流动的接口地址
QIANFAN_API_KEY= # 百度千帆的 API Key，未使用可留空
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2 # 百度千帆的接口地址
OPENAI_API_KEY= # OpenAI 的 API Key，未使用可留空
OPENAI_BASE_URL=https://api.openai.com/v1 # OpenAI 的接口地址

# 模型路由与能力配置
AVAILABLE_MODELS=deepseek-v4-flash,deepseek-v4-pro,qwen-max,glm-4.5-air,kimi-k2.6,hunyuan-lite,gpt-4o-mini # 前端下拉框展示的模型列表
MODEL_PROVIDER_OVERRIDES_JSON={"hunyuan-lite":"hunyuan","gpt-4o-mini":"openai"} # 手工指定模型与供应商映射，避免只靠模型名前缀判断
MODEL_CAPABILITIES_JSON= # 自定义模型能力覆盖，例如是否支持联网搜索或深度思考
EXTRA_PROVIDER_CONFIGS_JSON= # 额外 OpenAI 兼容网关配置，接自建代理时再填写
DEEPSEEK_DEEP_REASONING_EFFORT=high # DeepSeek 深度推理强度，可选 low、medium、high
QWEN_DEEP_THINKING_BUDGET=2048 # 通义模型的深度思考预算，数值越大通常越耗 token

# 本地嵌入模型配置
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5 # 用于向量检索的本地 embedding 模型名称
EMBEDDING_DEVICE=cpu # embedding 模型运行设备，可选 cpu 或 cuda
HF_ENDPOINT=https://huggingface.co # Hugging Face 主下载地址，官方可用时优先走这里
HF_FALLBACK_ENDPOINT=https://hf-mirror.com # Hugging Face 备用镜像地址，主地址失败时自动兜底尝试这个
HF_HUB_DISABLE_TELEMETRY=1 # 关闭 Hugging Face 遥测，减少无关网络请求

# 联网搜索配置
WEB_SEARCH_PROVIDER=none # 联网搜索供应商，可选 none、serper、tavily，本地先关掉更省心
WEB_SEARCH_API_KEY= # 联网搜索服务的 API Key，未启用联网搜索可留空
WEB_SEARCH_TOP_K=5 # 每次联网搜索返回的候选结果数量

# 成本估算配置
COST_CURRENCY=USD # 前端展示费用估算使用的货币单位
MODEL_PRICING_JSON={"deepseek-v4-flash":{"input_per_1m_tokens":0.14,"output_per_1m_tokens":0.28},"deepseek-v4-pro":{"input_per_1m_tokens":0.435,"output_per_1m_tokens":0.87}} # 模型价格配置，按每百万 token 估算输入与输出成本

# RAG 检索与生成参数
TOP_K=4 # 每次检索返回给大模型的文档片段数量
CHUNK_SIZE=800 # 文档切片大小，越大上下文更完整但召回会更粗
CHUNK_OVERLAP=120 # 相邻切片的重叠字符数，用于减少切片断裂造成的信息损失
TEMPERATURE=0.2 # 生成温度，越低越稳，越高越发散
MAX_TOKENS=1024 # 单次回答允许生成的最大 token 数
MAX_UPLOAD_MB=20 # 单个上传文件允许的最大体积，单位 MB

# 前端访问配置
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 # 允许跨域访问后端的前端地址，多个地址用英文逗号分隔

# 文档预览转换配置
PREVIEW_CONVERT_TIMEOUT_SEC=120 # 文档转 PDF 预览的超时时间，单位秒
SOFFICE_BIN= # LibreOffice 的 soffice 路径，用于 Office 转 PDF 兜底与旧版 .ppt 转 .pptx 后抽取；Windows 例子是 C:\Program Files\LibreOffice\program\soffice.exe，Linux / Docker 常见是 /usr/bin/soffice

# ONLYOFFICE 在线编辑配置
ONLYOFFICE_DOCUMENT_SERVER_URL=http://127.0.0.1:8088 # 浏览器访问 ONLYOFFICE 文档服务的地址
ONLYOFFICE_DOCUMENT_SERVER_INTERNAL_URL=http://127.0.0.1:8088 # 后端探活和命令调用 ONLYOFFICE 时使用的地址
PUBLIC_BACKEND_URL=http://host.docker.internal:8000 # 当 ONLYOFFICE 在 Docker、后端在本机时，推荐使用这个后端公开地址
PUBLIC_BACKEND_INTERNAL_URL=http://127.0.0.1:8000 # 后端进程自己探活或内网访问时使用的地址
ONLYOFFICE_JWT_ENABLED=true # 是否启用 ONLYOFFICE 的 JWT 安全校验，本地与生产建议保持开启
ONLYOFFICE_JWT_SECRET=local-onlyoffice-secret # 本地示例密钥，生产环境请务必替换，并保持后端与 ONLYOFFICE 一致
ONLYOFFICE_VERIFY_CALLBACK_TOKEN=false # 是否严格校验 ONLYOFFICE 回调携带的 token
ONLYOFFICE_AUTO_REBUILD_INDEX_ON_SAVE=true # ONLYOFFICE 保存文档后是否自动更新知识库索引
ONLYOFFICE_INDEX_UPDATE_MODE=incremental # 保存后索引更新模式，可选 incremental 或 full
ONLYOFFICE_CALLBACK_TTL_SEC=86400 # ONLYOFFICE 回调 token 的有效期，单位秒