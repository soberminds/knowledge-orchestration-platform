{
  "project": "smart-water-demo",
  "environment": "local-test",
  "features": {
    "onlyoffice": true,
    "rag_index_on_save": true,
    "light_preview": true
  },
  "thresholds": {
    "warn_level_m": 2.5,
    "alarm_level_m": 3.2,
    "offline_minutes": 10
  },
  "nodes": [
    {
      "name": "North Canal Gate",
      "type": "camera",
      "enabled": true
    },
    {
      "name": "East Pump Station",
      "type": "sensor",
      "enabled": true
    },
    {
      "name": "West Sluice",
      "type": "controller",
      "enabled": false
    }
  ]
}
